    "version": "0.2.0",
"configurations": [
        {
            "name": "Attach to QEMU",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "external",
            "gdbTarget": "localhost:1234",
            "executable": "${workspaceFolder}/app.elf",
            "cwd": "${workspaceFolder}",
            "armToolchainPath": "/usr/bin",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "runToEntryPoint": "main",
            "svdFile": "${workspaceFolder}/svd/Cortex-M33.svd"
        }
    ]
}